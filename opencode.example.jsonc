{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    [
      // Local V1 build. Run `bun run build` first.
      "./dist/index.js",
      {
        // false: Copilot picks a model for every prompt (default).
        // true:  keep the first model Copilot picks for the whole session.
        "sticky": false,
        // Toast which model Copilot picked. Once per prompt, or once per session when sticky.
        "notifications": true
      }
    ]
  ]
}
