{
  "name": "@opeoginni/opencode-copilot-auto",
  "version": "0.2.0",
  "description": "GitHub Copilot Auto model selection and tiers for OpenCode V1",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "github-copilot",
    "copilot",
    "auto-model"
  ],
  "license": "MIT",
  "author": "Opeyemi Oginni",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpeOginni/opencode-copilot-auto.git"
  },
  "homepage": "https://github.com/OpeOginni/opencode-copilot-auto#readme",
  "bugs": {
    "url": "https://github.com/OpeOginni/opencode-copilot-auto/issues"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
